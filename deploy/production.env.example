# Copy to a protected path outside Git, replace every placeholder, then run the preflight.
APP_ENV=production
DATABASE_URL=postgresql://user:replace-with-secret@database.internal/commerceops?sslmode=require
CORS_ALLOWED_ORIGINS=https://ops.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.ops.example.com
OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_ENDPOINT=https://objects.example.com
OBJECT_STORAGE_BUCKET=replace-with-private-bucket
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=replace-with-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-secret-key
OBJECT_STORAGE_PATH_STYLE=false
COMMERCEOPS_API_IMAGE=registry.example.com/commerceops-api@sha256:replace-with-64-character-digest
COMMERCEOPS_WEB_IMAGE=registry.example.com/commerceops-web@sha256:replace-with-64-character-digest
COMMERCEOPS_API_PORT=8080
COMMERCEOPS_WEB_PORT=3000
SHUTDOWN_TIMEOUT=30s
DATABASE_TIMEOUT=3s
SESSION_LIFETIME=12h
HTTP_READ_TIMEOUT=2m
HTTP_WRITE_TIMEOUT=5m
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=1048576
